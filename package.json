{
  "name": "ezcli",
  "version": "1.0.0",
  "private": true,
  "description": "ezCLI — a Freebuff-styled GUI shell for the Claude and Codex/ChatGPT command line agents.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "icons": "node scripts/build-icons.js",
    "package": "electron-builder --win --x64",
    "package:all": "electron-builder -mwl"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.aryansingh.ezcli",
    "productName": "ezCLI",
    "copyright": "Copyright © 2026 Aryan Singh",
    "directories": {
      "output": "dist",
      "buildResources": "docs"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "agents.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "docs/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDir": true,
      "createDesktopShortcut": true,
      "shortcutName": "ezCLI"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "docs/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "docs/icons",
      "category": "Development"
    }
  }
}
